# Environment configuration for the Lahore Speedo Bus Guide rebuild.
#
# Copy this file to `.env` (git-ignored) or pass the values as
# `--dart-define` flags at build time. Never commit real values.
#
#   flutter build apk --release \
#     --dart-define=FEEDBACK_ENDPOINT=https://your-backend.example/feedback
#
# ---------------------------------------------------------------------------

# Optional REST endpoint that receives feedback submissions.
# The original app wrote to the Firestore collection "feedback"
# (fields: name, email, location, type, comment, platform, createdAt).
# Leave empty to keep the UI's success path while submitting nowhere.
FEEDBACK_ENDPOINT=

# Optional: map tile provider (defaults to OpenStreetMap, no key required).
# MAP_TILE_TEMPLATE=

# Optional: Google Maps API key, only if you switch the Map screen to the
# Google provider. The original APK shipped a key restricted to a different
# package name and signing certificate, so it is NOT reused here.
# GOOGLE_MAPS_API_KEY=
