<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recovered from the original APK (see reverse_engineering/permissions.md).
         Only the permissions the rebuilt functionality legitimately needs are
         declared: no ads, no billing, no Play-integrity/anti-tamper wrappers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Needed by flutter_map / url_launcher to resolve external targets. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:label="Lahore Speedo Bus Guide"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Flutter launch theme. Mirrors the original AppTheme
                 (Theme.AppCompat.DayNight.NoActionBar, windowIsTranslucent,
                 forceDarkAllowed=false). -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- OpenStreetMap attribution crediting, as required by the ODbL. -->
        <meta-data
            android:name="org.osmdroid.TILE_SOURCE_OVERRIDE"
            android:value="OpenStreetMap" />
    </application>
</manifest>
